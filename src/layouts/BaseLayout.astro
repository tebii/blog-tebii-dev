---
import "../styles/terminal.css";
import SidebarLayout from "../components/SidebarLayout.astro";
import { buildSidebarItems, activeKeyFromPath } from "../lib/sidebar";
import CommandBar from "../components/CommandBar.astro";

const {
  title = "blog.tebii.dev",
  description = "Cybersecurity writeups, HTB walkthroughs, and bug bounty research.",
  canonicalPath,
  currentSlug = "",
} = Astro.props;

const canonical = canonicalPath
  ? new URL(canonicalPath, Astro.site ?? "https://blog.tebii.dev").toString()
  : undefined;

// Auto sidebar + active tab based on URL
const sidebarItems = await buildSidebarItems();
const active = activeKeyFromPath(Astro.url.pathname);
---

<html lang="en">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#1e1e2e" />
    <script is:inline>
      if(sessionStorage.getItem('visited')){document.documentElement.classList.add('no-anim')}
      else{sessionStorage.setItem('visited','1')}
    </script>
  </head>

  <body>

    <div class="page">

      <div class="term">

        <div class="term-topbar">
          <div class="term-tabs">
            <span class="term-tab active">{title}</span>
          </div>
          <a class="term-actions" href="https://tebii.dev" aria-label="Go to tebii.dev" id="dots-link">
            <span class="dot y"></span><span class="dot g"></span><span class="dot r"></span>
          </a>
        </div>

        <div class="term-body">

          <SidebarLayout title="blog.tebii.dev" active={active} items={sidebarItems} currentSlug={currentSlug}>
            <slot />

          </SidebarLayout>

<CommandBar />
        </div>

      </div>

    </div>
  <script>
    document.getElementById('dots-link')?.addEventListener('click', e => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).href;
      const term = document.querySelector('.term') as HTMLElement;
      sessionStorage.removeItem('visited');
      term.classList.add('closing');
      term.addEventListener('animationend', () => { window.location.href = href; }, { once: true });
    });
  </script>
</body>
</html>
