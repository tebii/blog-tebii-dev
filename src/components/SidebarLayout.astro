---
const {
  active = "writeups",
  items = [],
  currentSlug = "",
} = Astro.props;

// Find which group the current post lives in
const activeGroupLabel = (() => {
  for (const it of items) {
    for (const grp of it.groups ?? []) {
      if (grp.posts.some((p) => p.slug === currentSlug)) return grp.label;
    }
  }
  return null;
})();
---

<div class="app">
  <aside class="sidebar">
    <div class="side-title">
      <div>
        <div class="side-brand">tebii</div>
        <div class="side-sub">i write stuff</div>
      </div>
    </div>

    <nav class="filetree">
      {items.map((it, idx) => {
        const isLast = idx === items.length - 1;
        const isActive = active === it.key;
        const hasGroups = it.groups && it.groups.length > 0;
        return (
          <div class="ft-item-wrap">
            <div class="ft-row">
              <span class="ft-branch">{isLast ? "└─" : "├─"}</span>
              <a class={`ft-link ft-dir ${isActive ? "active" : ""}`} href={it.href}>
                <span class="ft-name">{it.label}</span>
                {typeof it.count === "number" && (
                  <span class="ft-count">{it.count}</span>
                )}
              </a>
            </div>

            {hasGroups && isActive &&
              it.groups!.map((grp, gi) => {
                const grpLast = gi === it.groups!.length - 1;
                const isOpenGroup = grp.label === activeGroupLabel;
                const pipe = isLast ? "   " : "│  ";
                return (
                  <div class="ft-group">
                    <div class="ft-row">
                      <span class="ft-indent">{pipe}</span>
                      <span class="ft-branch">{grpLast ? "└─" : "├─"}</span>
                      <span class="ft-subdir">{grp.label}</span>
                    </div>

                    {isOpenGroup && grp.posts.map((post, pi) => {
                      const postLast = pi === grp.posts.length - 1;
                      const isCurrent = currentSlug === post.slug;
                      return (
                        <div class="ft-row">
                          <span class="ft-indent">{pipe}</span>
                          <span class="ft-indent">{grpLast ? "   " : "│  "}</span>
                          <span class="ft-branch">{postLast ? "└─" : "├─"}</span>
                          <a
                            class={`ft-link ft-file ${isCurrent ? "current" : ""}`}
                            href={post.href}
                          >
                            <span class="ft-name">{post.label}</span>
                          </a>
                        </div>
                      );
                    })}
                  </div>
                );
              })}
          </div>
        );
      })}
    </nav>
  </aside>

  <section class="content">
    <slot />
  </section>
</div>
